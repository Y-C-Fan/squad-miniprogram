/* 数据页 */

.hero {
  padding: 40rpx 0 32rpx;
  text-align: center;
}

.hero-num {
  font-size: 110rpx;
  font-weight: 700;
  line-height: 1;
  color: #c6f24e;
  font-variant-numeric: tabular-nums;
}

.hero-unit {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .45);
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, .42);
}

.hero-sub .dot {
  margin: 0 10rpx;
  opacity: .5;
}

.grid {
  display: flex;
  margin-bottom: 24rpx;
  background: #16181d;
  border: 1rpx solid #262a32;
  border-radius: 28rpx;
  overflow: hidden;
}

.grid-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  border-right: 1rpx solid #21252c;
}

.grid-item:last-child {
  border-right: none;
}

.gv {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.gl {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, .4);
}

/* 柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 230rpx;
  padding-top: 24rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 44rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .12);
  transition: height .3s ease;
}

.bar.today {
  background: #c6f24e;
}

.bar-v {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .6);
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

.bar-l {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, .38);
}

/* 热力图 */
.heat {
  display: grid;
  grid-template-rows: repeat(7, 22rpx);
  grid-auto-flow: column;
  grid-gap: 8rpx;
  justify-content: start;
}

.hcell {
  width: 22rpx;
  height: 22rpx;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, .06);
}

.hcell.future {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, .07);
}

.hcell.lv1 { background: rgba(198, 242, 78, .22); }
.hcell.lv2 { background: rgba(198, 242, 78, .45); }
.hcell.lv3 { background: rgba(198, 242, 78, .72); }
.hcell.lv4 { background: #c6f24e; }

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, .35);
}

/* 勋章 */
.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.badge {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #101216;
  border: 1rpx solid #262a32;
  opacity: .55;
}

.badge.on {
  opacity: 1;
  border-color: rgba(198, 242, 78, .45);
  background: rgba(198, 242, 78, .06);
}

.b-icon {
  font-size: 30rpx;
  font-weight: 700;
  color: #c6f24e;
}

.b-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.b-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, .42);
}

.b-bar {
  margin-top: 14rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .1);
  overflow: hidden;
}

.b-bar-in {
  height: 100%;
  background: #c6f24e;
}

.b-val {
  display: block;
  margin-top: 8rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, .32);
  font-variant-numeric: tabular-nums;
}

/* 记录 */
.record {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #21252c;
}

.record:last-child {
  border-bottom: none;
}

.r-left { flex: 1.1; }
.r-mid { flex: 1; text-align: right; }

.r-day {
  display: block;
  font-size: 27rpx;
  color: #ffffff;
}

.r-time {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, .38);
}

.r-dur {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .62);
}

.r-cal {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, .35);
}

.r-count {
  width: 120rpx;
  text-align: right;
  font-size: 44rpx;
  font-weight: 700;
  color: #c6f24e;
  font-variant-numeric: tabular-nums;
}

/* 空态 */
.empty {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.empty-t {
  display: block;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, .4);
}

.empty-btn {
  width: 280rpx;
  margin: 0 auto;
  font-size: 27rpx;
  padding: 22rpx 0;
}
