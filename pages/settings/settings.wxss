/* 设置页 */

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #21252c;
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  font-size: 28rpx;
  color: rgba(255, 255, 255, .85);
}

.row-input {
  width: 200rpx;
  text-align: right;
  font-size: 30rpx;
  color: #c6f24e;
  font-variant-numeric: tabular-nums;
}

.sub-title {
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .45);
  letter-spacing: 1rpx;
}

.hint-row {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, .38);
}

.code {
  color: rgba(198, 242, 78, .8);
}
