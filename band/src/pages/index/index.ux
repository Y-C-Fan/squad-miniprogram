<template>
  <div class="page">
    <div class="header">
      <text class="title">蹲队</text>
      <text class="mode" onclick="toggleMode">{{ modeLabel }}</text>
    </div>

    <div class="count-wrap">
      <text class="count">{{ count }}</text>
      <text class="unit">次</text>
    </div>

    <text class="hint">{{ tip }}</text>

    <div class="calib" if="{{ !calibrated }}">
      <div class="calib-track">
        <div class="calib-fill" style="width: {{ calibPct }}%;"></div>
      </div>
      <text class="calib-text">{{ calibrating ? '站着别动，正在校准 ' + calibPct + '%' : calibHint }}</text>
      <text class="calib-sub" if="{{ !calibrating }}">平均运动量 {{ motionAvg }} · 阈值 0.5</text>
    </div>

    <div class="bar-track" if="{{ running && calibrated }}">
      <div class="bar-fill" style="width: {{ ringPct }}%;"></div>
    </div>

    <div class="stats">
      <text class="stat">{{ timeText }}</text>
      <text class="stat" if="{{ running }}">{{ stateText }}</text>
      <text class="stat" if="{{ !running }}">今日 {{ todayCount }}</text>
    </div>

    <div class="btn main" onclick="toggle">
      <text class="btn-text">{{ running ? "结束并保存" : "开始训练" }}</text>
    </div>

    <text class="foot" if="{{ !running }}">灵敏度：中 · 站着别动 1 秒</text>
  </div>
</template>

<script>
import sensor from '@system.sensor'
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import SquatDetector from '../../common/squat-detector.js'

var MODE_LABEL = { tilt: '口袋', lift: '手持' }
var KEY_TODAY = 'sq_today'

function pad(n) { return n < 10 ? '0' + n : '' + n }
function dayKey(ts) {
  var d = new Date(ts)
  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
}

export default {
  private: {
    running: false,
    count: 0,
    seconds: 0,
    timeText: '00:00',
    tip: '点击开始，站着别动 1 秒',
    ringPct: 0,
    mode: 'lift',
    modeLabel: '手持',
    todayCount: 0,
    stateText: '',
    // 校准状态：把手环上的校准过程显式画出来。
    // 之前的版本只写 "校准中" 三个字，用户看不到进度，也不知道自己在动会导致计时归零，
    // 真机反馈是"校准完了还一直显示校准中"—— 其实是没校准上，但界面不告诉用户原因。
    calibrating: true,
    calibrated: false,
    calibPct: 0,
    calibHint: '站稳别动，检测到晃动会重新计时',
    motionAvg: '0.00'
  },

  onInit() {
    this.detector = new SquatDetector({ mode: this.mode, sensitivity: 'medium' })
    this.timer = null
    this.ringPct = 0
    this.stateText = ''
  },

  onShow() {
    var self = this
    // 读取今日累计。只在同一自然日内累加，跨天自动归零。
    try {
      storage.get({
        key: KEY_TODAY,
        success: function (res) {
          var v = res.data
          if (v && v.key === dayKey(Date.now())) self.todayCount = v.count || 0
          else self.todayCount = 0
        },
        fail: function () { self.todayCount = 0 }
      })
    } catch (e) {
      console.log('读取历史失败 ' + e)
    }
  },

  onHide() {
    // Vela 在 onHide 后 30 秒若无活动定时器或传感器会被 Runtime 强制冻结，
    // 所以离开页面必须把资源收掉，回来再在 onShow 里重建。
    this.stopSensor()
    this.stopTimer()
    if (this.running) this.finish(false)
  },

  onDestroy() {
    this.stopSensor()
    this.stopTimer()
  },

  toggle() {
    if (this.running) this.finish(false)
    else this.start()
  },

  start() {
    this.detector = new SquatDetector({ mode: this.mode, sensitivity: 'medium' })
    this.running = true
    this.count = 0
    this.seconds = 0
    this.timeText = '00:00'
    this.ringPct = 0
    this.stateText = ''
    this.calibrating = true
    this.calibrated = false
    this.calibPct = 0
    this.motionAvg = '0.00'
    this.calibHint = '站稳别动，检测到晃动会重新计时'
    this.tip = '站着别动 1 秒完成校准'

    this.startSensor()
    this.startTimer()
    this.vibrate('heavy')
  },

  finish() {
    this.stopSensor()
    this.stopTimer()
    this.running = false
    this.stateText = ''
    this.ringPct = 0
    this.calibrating = true
    this.calibrated = false
    this.calibPct = 0

    if (this.count > 0) {
      this.saveSession()
      this.vibrate('heavy')
      this.tip = '完成 ' + this.count + ' 次'
    } else {
      this.tip = '没数到，试试换个摆放'
    }
  },

  toggleMode() {
    // 手环戴在手腕上，倾角会被手臂摆动污染，所以默认走垂直位移检测。
    // 点右上角可以在两种模式间切换对比。
    this.mode = this.mode === 'lift' ? 'tilt' : 'lift'
    this.modeLabel = MODE_LABEL[this.mode]
    if (this.running) this.detector.setMode(this.mode)
    else this.detector = new SquatDetector({ mode: this.mode, sensitivity: 'medium' })
    this.tip = '已切到' + this.modeLabel + '模式'
  },

  vibrate(type) {
    try {
      vibrator.vibrate({ type: type || 'light' })
    } catch (e) {
      console.log('振动失败 ' + e)
    }
  },

  startSensor() {
    var self = this
    try {
      sensor.subscribeAccelerometer({
        // game ≈ 20ms/次，与微信小程序同量级，所以算法阈值可原样复用
        interval: 'game',
        callback: function (ret) { self.onAcc(ret) },
        fail: function (msg, code) {
          console.error('加速度计订阅失败 ' + msg + ' ' + code)
          self.tip = '传感器不可用'
        }
      })
    } catch (e) {
      console.error('subscribeAccelerometer 异常 ' + e)
      this.tip = '传感器启动失败'
    }
  },

  stopSensor() {
    try { sensor.unsubscribeAccelerometer() } catch (e) {}
  },

  onAcc(ret) {
    if (!this.running) return
    var r = this.detector.push({ x: ret.x, y: ret.y, z: ret.z }, Date.now())

    if (r.ready) {
      // 校准通过
      if (!this.calibrated) {
        this.calibrating = false
        this.calibrated = true
        this.calibPct = 100
        this.tip = '校准完成，开始深蹲'
        this.vibrate('heavy')
      }
    } else {
      // 校准中：把进度和运动量显式画出来。
      // 用户抱怨的"一直显示校准中"多半是手在动 —— 让他看到运动量数值和阈值，
      // 才知道要把手放稳，而不是盯着一个不动的进度条干等。
      var pct = Math.round(r.calibProgress * 100)
      if (pct !== this.calibPct) {
        this.calibPct = pct
      }
      var avg = this.detector.motionAvg
      this.motionAvg = avg.toFixed(2)
      if (avg > 0.5) {
        this.calibHint = '检测到晃动，请放稳手臂'
      } else {
        this.calibHint = '很好，保持不动'
      }
    }

    if (r.counted) {
      this.count = this.detector.count
      this.ringPct = Math.round((this.count % 20) / 20 * 100)
      this.vibrate('light')
      if (this.count % 10 === 0) {
        this.vibrate('heavy')
        this.tip = this.count + ' 次！'
      }
    } else if (r.ready) {
      this.ringPct = Math.round(r.progress * 100)
      this.stateText = r.state === 'bottom' ? '下蹲' : '站立'
    }
  },

  startTimer() {
    var self = this
    this.stopTimer()
    this.timer = setInterval(function () {
      self.seconds += 1
      var m = Math.floor(self.seconds / 60)
      var s = self.seconds % 60
      self.timeText = pad(m) + ':' + pad(s)
    }, 1000)
  },

  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  saveSession() {
    this.todayCount += this.count
    var self = this
    var payload = { key: dayKey(Date.now()), count: this.todayCount, at: Date.now() }
    try {
      storage.set({
        key: KEY_TODAY,
        value: payload,
        success: function () { console.log('已保存今日 ' + self.todayCount + ' 次') },
        fail: function (msg, code) { console.error('保存失败 ' + msg + ' ' + code) }
      })
    } catch (e) {
      console.error('storage 异常 ' + e)
    }
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background-color: #0b0c0f;
  padding: 10px 8px 14px;
  width: 100%;
  height: 100%;
}

.header {
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 13px;
  color: #c6f24e;
  font-weight: bold;
}

.mode {
  font-size: 10px;
  color: #8a8f99;
  padding: 3px 7px;
  border-radius: 8px;
  background-color: #1f232b;
}

.count-wrap {
  flex-direction: row;
  align-items: baseline;
}

.count {
  font-size: 52px;
  color: #ffffff;
  font-weight: bold;
}

.unit {
  font-size: 12px;
  color: #6b7280;
  margin-left: 3px;
}

.hint {
  font-size: 10px;
  color: #6b7280;
  text-align: center;
  height: 14px;
}

.bar-track {
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background-color: #1f232b;
}

/* 校准区：把"为什么还没校准成功"直接告诉用户 */
.calib {
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.calib-track {
  width: 100%;
  height: 5px;
  border-radius: 3px;
  background-color: #1f232b;
  overflow: hidden;
}

.calib-fill {
  height: 100%;
  border-radius: 3px;
  background-color: #ff6b35;
}

.calib-text {
  font-size: 10px;
  color: #ff9a78;
  margin-top: 4px;
  text-align: center;
}

.calib-sub {
  font-size: 9px;
  color: #6b7280;
  margin-top: 2px;
}

.bar-fill {
  height: 100%;
  border-radius: 2px;
  background-color: #c6f24e;
}

.stats {
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
  min-height: 14px;
}

.stat {
  font-size: 11px;
  color: #8a8f99;
}

.btn {
  width: 100%;
  border-radius: 26px;
  align-items: center;
  justify-content: center;
  padding: 10px 0;
  background-color: #c6f24e;
}

.btn text {
  font-size: 15px;
  color: #10120a;
  font-weight: bold;
}

.foot {
  font-size: 9px;
  color: #4a4f58;
}
</style>
